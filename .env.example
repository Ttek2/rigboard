# RigBoard Configuration
# Copy this to .env and modify as needed

# Port to expose (default: 3000)
PORT=3000

# Timezone (default: Europe/Dublin)
TZ=Europe/Dublin

# Data directory inside container (default: /app/data)
# In development, set to ./data
DATA_DIR=./data

# Base URL for the Community Pulse / trending API (default: https://ttek2.com)
# Only change this if the upstream ttek2 API moves.
# TTEK2_BASE_URL=https://ttek2.com
